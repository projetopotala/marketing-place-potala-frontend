# Copie para .env.local e ajuste se necessário. Nunca versione .env.local
# (já está no .gitignore).

# URL pública de potala-api-gateway (ponto único de entrada de todos os
# serviços de backend). NEXT_PUBLIC_ é obrigatório aqui: este valor é lido em
# componentes client ("use client") — como AuthContext — e o Next.js só
# inclui variáveis NEXT_PUBLIC_* no bundle que roda no navegador.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
