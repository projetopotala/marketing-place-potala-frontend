# Copie para .env.local e ajuste se necessário. Nunca versione .env.local
# (já está no .gitignore).

# URL de potala-api-gateway usada no servidor e no proxy /api/v1.
# O navegador usa /api/v1 na origem do site para enviar o cookie de sessão.
# NEXT_PUBLIC_API_BASE_URL continua aceito como fallback para instalações antigas.
API_UPSTREAM_URL=http://localhost:8080/api/v1

# Origem pública para canonical, sitemap e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://marketing-place-potala.vercel.app
